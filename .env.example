# Which avatar provider. UNSET FALLS BACK TO liveavatar, which is not the show.
AVATAR_PROVIDER=tavus

TAVUS_API_KEY=paste-key-here
PORT=3000

# Faces. Tavus renamed replicas to faces. List what the account has at
# /api/avatars, or /api/avatars?custom=1 for our own trained ones.
# TAVUS_FACE_DEFAULT=
# TAVUS_FACE_peter=
# TAVUS_FACE_margaret=
# TAVUS_FACE_rami=

# Voice: leave unset. With no tts layer Tavus uses the face's own cloned voice,
# which is what we want. Setting this overrides it with an external voice.
# TAVUS_VOICE_DEFAULT=
# TAVUS_TTS_ENGINE=elevenlabs
# TAVUS_TTS_API_KEY=

# A forgotten tab costs money, so cap it well short of their 1-hour default.
TAVUS_MAX_CALL_SECONDS=600

# Testing only - MUST stay false for the RANZCO build. Nothing is recorded at the stand.
KEEP_TRANSCRIPTS=false

# A date after which transcripts stop regardless of the setting above.
TRANSCRIPTS_CUTOFF=2026-11-06

# test | live. Unset defaults to live, which is the RANZCO setting.
# live hides the clinical file panel, the reveal card and the transcript drawer.
DISPLAY_MODE=live

# The stand. ROOM_ID is A or B; CONTROL_PIN must be the SAME on both show PCs or
# the phone page cannot drive the other room.
ROOM_ID=A
ROTATION=margaret,peter,rami
# SHOW_PERSONAS=peter        # restrict who is reachable at all; unset means all three
# CONTROL_PIN=
# PEER_URL=http://other-pc:3000

# Key the patient onto the stand background.
CHROMA_KEY=true
BACKGROUND_COLOR=#003595

# A count of consults, not minutes. /api/session refuses the next one past this.
# SESSION_BUDGET=40

# LiveAvatar only - these do nothing on Tavus.
# LIVEAVATAR_API_KEY=
# LIVEAVATAR_SANDBOX=true
# PUSH_TO_TALK=false
