# Copy to secrets.env and keep it on the USB stick, never in the repo.
# install.ps1 appends this to the generated .env.

TAVUS_API_KEY=

TAVUS_FACE_peter=
TAVUS_FACE_margaret=
TAVUS_FACE_rami=

# Host control page. A deterrent, not authentication.
CONTROL_PIN=

# The other room's public tunnel hostname, so one phone page drives both.
# Room A gets room B's, and the other way round.
PEER_URL=
